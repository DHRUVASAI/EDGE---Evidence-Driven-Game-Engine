# ─── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL (default if you run PostgreSQL locally)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/cricmetrics"
# If using Supabase or remote DB, also add DIRECT_URL:
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── CricAPI (Live Match Scores) ─────────────────────────────────────────────
# Free tier: 100 requests/day — get your key at https://cricapi.com
CRICAPI_KEY="your_cricapi_key_here"

# ─── Google Gemini (AI Match Advisor — Primary) ───────────────────────────────
# Free tier available — get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="your_google_gemini_api_key_here"

# ─── Groq (AI Fallback — Optional) ───────────────────────────────────────────
# Free tier available — get your key at https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"

# ─── ETL Data Path (only needed if running the ingestion scripts) ─────────────
# Path to your downloaded Cricsheet JSON folder (from https://cricsheet.org/downloads/)
# CRICSHEET_DATA_DIR="/path/to/your/cricsheet/data"
