# ─── Next.js ────────────────────────────────────────────────────────────────
/.next/
/out/
/build

# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Environment (NEVER commit real .env) ────────────────────────────────────
.env
.env.local
.env.*.local
