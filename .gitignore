**/.venv/
**/__pycache__/
*.pyc
*.pyo

# ─── Prisma ──────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Misc ────────────────────────────────────────────────────────────────────
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
secrets/
.vercel

# ─── Dev-only scratch folder ─────────────────────────────────────────────────
other/
